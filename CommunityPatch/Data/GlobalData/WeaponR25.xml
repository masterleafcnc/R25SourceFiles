			MaxSeconds="0.1s" />
		<Nuggets>
			<AttributeModifierNugget
				Radius="100.0"
				PartitionFilterTestType="CIRCLE"
				ForbiddenTargetObjectStatus="IN_STASIS"
				AttributeModifierName="AttributeModifier_AlienPhaseFieldMechas">
				<SpecialObjectFilter
					Rule="NONE"
					Relationship="ALLIES">
					<IncludeThing>Reaper17CustomizableVehicle</IncludeThing>
					<IncludeThing>Traveler59CustomizableVehicle</IncludeThing>
					<IncludeThing>AlienCustomizableVehicle</IncludeThing>
				</SpecialObjectFilter>
			</AttributeModifierNugget>

			<WeaponOCLNugget WeaponOCL="OCL_PhaseDummy" />
		</Nuggets>
	</WeaponTemplate>

	<WeaponTemplate
		id="AlienPhaseFieldWeapon"
		Name="AlienPhaseFieldWeapon"
		RadiusDamageAffects="ALLIES"
		AttackRange="50000.0"
		>
		<!-- FireSound="ALI_PhaseGenerator_Begin" no worky -->
		<!-- FireFX="FX_ALI_PhaseGenerator_Begin" no worky -->
		<Nuggets>
		<!-- spawn a dummy that fires a weapon on created 	-->

		<LuaEventNugget
			Radius="100.0"
			PartitionFilterTestType="CIRCLE"
			EventName="PhaseFieldEvent"
			SendToAllies="true"
		>
		<!-- RejectStatusBitFlags="USER_PARALYZED" doesnt work so i have to do a check in the script to prevent phasing units inside of stasis -->
			<SpecialObjectFilter
					Relationship="ALLIES"
					Rule="ANY"
					Exclude="AIRCRAFT INFANTRY"
					Include="VEHICLE">
					<!-- MCVs are phaseable, including the scrin family unpacking objects for
					     the few seconds they are on the ground. keep in sync with the
					     ObjectFilter of SpecialPower_PhaseField in SpecialPowerTemplates.xml -->
					<IncludeThing>AlienMCV</IncludeThing>
					<IncludeThing>AlienMCVUnpacking</IncludeThing>
					<IncludeThing>Reaper17MCV</IncludeThing>
					<IncludeThing>Reaper17MCVUnpacking</IncludeThing>
					<IncludeThing>Traveler59MCV</IncludeThing>
					<IncludeThing>Traveler59MCVUnpacking</IncludeThing>
					<ExcludeThing>Viceroid</ExcludeThing>
					<ExcludeThing>Reaper17CustomizableVehicle</ExcludeThing>
					<ExcludeThing>Traveler59CustomizableVehicle</ExcludeThing>
					<ExcludeThing>AlienCustomizableVehicle</ExcludeThing>
					<ExcludeThing>AlienMillipedeBody</ExcludeThing>
					<ExcludeThing>AlienMillipedeHead</ExcludeThing>
				</SpecialObjectFilter>
		</LuaEventNugget>
		</Nuggets>
	</WeaponTemplate>

