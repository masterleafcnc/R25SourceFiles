<?xml version="1.0" encoding="us-ascii"?>
<AssetDeclaration xmlns="uri:ea.com:eala:asset">

	<WeaponTemplate
		id="ZoneTrooperMachineGun"
		Name="ZoneTrooperMachineGun"
		AttackRange="325.0"
		WeaponSpeed="999999.0"
		PreAttackType="PER_SHOT"
		ClipSize="1"
		AutoReloadsClip="AUTO"
		FireSound="AudioEvent:ZoneTrooperGunFire"
		FireFX="FX_RailGunFire"
		FireVeteranFX="FX_RailGunFireHeroic"
		RadiusDamageAffects="ALLIES ENEMIES NEUTRALS"
		AntiMask="ANTI_GROUND"
		CanFireWhileMoving="true"
		AcceptableAimDelta="10d"
		>

		<PreAttackDelay
		  MinSeconds="0.0s"
		  MaxSeconds="0.1s" />
		<FiringDuration
				MinSeconds="1.8s"
				MaxSeconds="2.2s" />
		<ClipReloadTime
				MinSeconds="0.23s"
				MaxSeconds="0.27s" />

		<Nuggets>
			<ActivateLaserNugget
				Lifetime="0.75s"
				LaserId="0"
				HitGroundFX="FX_RailGunHit"/>
			<DamageNugget
				Damage="210.0"
				Radius="0.0"
				DelayTimeSeconds="0.0s"
				DamageType="CANNON"
				DamageFXType="GDI_RAILGUN"
				DeathType="NORMAL" />
			<SuppressionNugget
				Radius="10.0"
				Suppression="100"
				DurationSeconds="5s" />
		</Nuggets>
		<ScatterRadiusVsType
		Radius="0.0">
			<Filter
				Rule="NONE"
				Include="INFANTRY" />
		</ScatterRadiusVsType>
	</WeaponTemplate>

