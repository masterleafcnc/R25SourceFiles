				<CustomAnimAndDuration
					AnimState="USER_4"></CustomAnimAndDuration>
				<TriggeredBy>Upgrade_ZoneRaiderAutoInjectors</TriggeredBy>
			</SubObjectsUpgrade>
		</Behaviors>
