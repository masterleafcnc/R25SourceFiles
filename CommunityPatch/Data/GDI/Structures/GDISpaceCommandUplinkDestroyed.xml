						Name="W3DContainer:GBSpcCmndX_RDY_D3" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="DYING">
					<Model
						Name="W3DContainer:GBSpcCmndX_D3" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="USER_1">
					<Model
						Name="W3DContainer:GBSpcCmndX_SKN" />
					<ParticleSysBone
						BoneName="FXBone01"
						FXParticleSystemTemplate="BuildingSteam"
						FollowBone="true" />
					<ParticleSysBone
						BoneName="FXBone02"
						FXParticleSystemTemplate="BuildingSteam"
						FollowBone="true" />
					<ParticleSysBone
						BoneName="FXBone03"
						FXParticleSystemTemplate="BuildingSteam"
						FollowBone="true" />						
				</ModelConditionState>
				<!-- ANIMATIONS -->
				<AnimationState
					ParseCondStateType="PARSE_DEFAULT"
					StateName="STATE_Idle">
					<Animation
						AnimationName="GBSpcCmndX_IDLA"
						AnimationMode="ONCE"
						AnimationBlendTime="0" />
					<Script>
						Prev = CurDrawablePrevAnimationState();
						if Prev == "STATE_Ready" and Prev ~= "STATE_Idle" then
						CurDrawableSetTransitionAnimState("TRANS_FIRING")
						end
					</Script>
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="STRUCTURE_UNPACKING">
					<Animation
						AnimationName="NBEmpty_ABLD"
						AnimationMode="ONCE" />
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="DYING USER_1">
					<Animation
						AnimationName="GBSpcCmndX_RDY_D3"
						AnimationMode="ONCE" />
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="DYING">
					<Animation
						AnimationName="GBSpcCmndX_D3"
						AnimationMode="ONCE" />
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="USER_1"
					StateName="STATE_Ready">
					<Animation
						AnimationName="GBSpcCmndX_RDY"
						AnimationMode="ONCE"
						AnimationBlendTime="0" />
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="PACKING">
					<Animation
						AnimationName="GBSpcCmndX_IDLA"
						AnimationMode="ONCE"
						AnimationBlendTime="0" />
				</AnimationState>
				<AnimationState
					ParseCondStateType="PARSE_TRANSITION"
					StateName="TRANS_FIRING">
					<Animation
						AnimationName="GBSpcCmndX_FIRA"
						AnimationMode="ONCE"
						AnimationBlendTime="0" />
					<ParticleSysBone
						BoneName="FXBone04"
						FXParticleSystemTemplate="NodNukeMissleSmoke"
						FollowBone="true" />
					<ParticleSysBone
						BoneName="FXBone04"
						FXParticleSystemTemplate="NodNukeMissleFire"
						FollowBone="true" />
				</AnimationState>
			</ScriptedModelDraw>
			
			<!-- Draw sonic repulsion field -->
			
