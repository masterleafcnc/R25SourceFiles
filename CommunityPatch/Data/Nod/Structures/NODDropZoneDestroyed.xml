						Name="W3DContainer:NBDrpZnX_SKN" />
					<Texture
						Original="NB_DropZone"
						New="NB_DropZoneD" />
				</ModelConditionState>
				<ModelConditionState
					ParseCondStateType="PARSE_NORMAL"
					ConditionsYes="REALLYDAMAGED">
					<Model
						Name="W3DContainer:NBDrpZnX_SKN" />
